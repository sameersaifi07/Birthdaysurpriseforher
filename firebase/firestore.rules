rules_version = '2';
// Published automatically by `firebase deploy` (or paste into Firestore → Rules → Publish).
// The developer email below must match adminEmails in config.js.
service cloud.firestore {
  match /databases/{db}/documents {
    // Only Google (Gmail) accounts can use the studio. Email/password sign-ins are refused everywhere.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['samsaifi2526@gmail.com'];
    }
    function isActive() {
      return signedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Customer accounts. Customers create their own record (never active); only the developer activates.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.active == false && request.resource.data.quota == 0)
                    || isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // The editable websites (text, list of media, PIN). Owner (when active) and developer only.
    match /sites/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if isAdmin() || (isActive() && request.resource.data.owner == request.auth.uid);
      allow update: if isAdmin() || (isActive() && resource.data.owner == request.auth.uid
                                     && request.resource.data.owner == resource.data.owner);
      allow delete: if isAdmin();
    }

    // What the partner's link reads: unlock time and PIN length only (content stays encrypted).
    match /public/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (isActive() && get(/databases/$(db)/documents/sites/$(id)).data.owner == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Shopify orders and paid-but-unclaimed websites. Written only by the backend (Cloud Functions).
    match /orders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /purchases/{email} {
      allow read, write: if isAdmin();
    }

    // Bug reports sent automatically by partners' phones. Anyone can add a small report; only the developer reads them.
    match /errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['site', 'kind', 'msg', 'src', 'ua', 'at'])
        && request.resource.data.site is string && request.resource.data.site.size() <= 64
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.src is string && request.resource.data.src.size() <= 500
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.at is timestamp;
      allow read, delete: if isAdmin();
    }
  }
}
